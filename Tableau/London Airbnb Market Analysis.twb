    <dashboard name='CQ Map Story' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>CQ1 — Identifying the optimal investment cluster</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='990' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='4357' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='178' h='18465' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='5187' />
            <zone h='75518' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='23652'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='The complex question is answered through coordinated interaction across multiple views. Selecting Westminster focuses the analysis on a high-value borough, while filtering to short stays (1–7 nights) reflects a typical investor strategy. Within this context, Cluster 2 emerges as the strongest performer, combining high price, strong demand, and high availability. The spatial map confirms that these listings are concentrated in central London. When the minimum-night filter is increased, the performance shifts toward a different cluster, indicating that optimal investment strategy depends on stay duration. This insight cannot be derived from any single chart, but emerges only through the coordinated interaction of ranking, spatial, and multivariate views.&#10;' captured-sheet='CQ Map' id='1'>
                    <currentDeltas>
                      <worksheet name='CQ Map'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1ndonkf00memyc14fp4nv1bgu3e9].[avg:latitude:qk]' field-type='quantitative' max='6748769.92297881' min='6661293.9755001431' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.1ndonkf00memyc14fp4nv1bgu3e9].[avg:longitude:qk]' field-type='quantitative' max='30586.870194638526' min='-60774.428277101651' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </currentDeltas>
                    <capturedDeltas />
                  </story-point>
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{36B31809-E8B3-4665-829F-DEB67EFF8364}' />
