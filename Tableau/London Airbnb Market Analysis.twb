      <aliases enabled='yes' />
      <column caption='Top 3 Highlight' datatype='string' name='[Calculation_0926676418174977]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(MEDIAN([price]), &apos;desc&apos;) &lt;= 3 THEN &quot;Top 3&quot;&#13;&#10;   ELSE &quot;Other&quot;&#13;&#10;   END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Outlier Flag' datatype='string' name='[Calculation_0926676420743170]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS( AVG([reviews_per_month]) - AVG({ FIXED : AVG([reviews_per_month]) }) )&#13;&#10;   &gt; 0.15 * AVG({ FIXED : STDEV([reviews_per_month]) })&#13;&#10;THEN &quot;Outlier&quot;&#13;&#10;ELSE &quot;Typical&quot;&#13;&#10;END' />
      </column>
