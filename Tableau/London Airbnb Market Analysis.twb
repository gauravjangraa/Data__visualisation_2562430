    <worksheet name='SQ2 Availability vs Demand'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>SQ2 - Avaiablity vs review per month  (outliers labelled)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='london_airbnb_final' name='federated.1ndonkf00memyc14fp4nv1bgu3e9' />
          </datasources>
          <datasource-dependencies datasource='federated.1ndonkf00memyc14fp4nv1bgu3e9'>
            <column caption='Outlier Flag' datatype='string' name='[Calculation_0926676420743170]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ABS( AVG([reviews_per_month]) - AVG({ FIXED : AVG([reviews_per_month]) }) )&#13;&#10;   &gt; 0.15 * AVG({ FIXED : STDEV([reviews_per_month]) })&#13;&#10;THEN &quot;Outlier&quot;&#13;&#10;ELSE &quot;Typical&quot;&#13;&#10;END' />
            </column>
            <column caption='Availability 365' datatype='integer' name='[availability_365]' role='measure' type='quantitative' />
            <column-instance column='[availability_365]' derivation='Avg' name='[avg:availability_365:qk]' pivot='key' type='quantitative' />
            <column-instance column='[reviews_per_month]' derivation='Avg' name='[avg:reviews_per_month:qk]' pivot='key' type='quantitative' />
            <column caption='Neighbourhood' datatype='string' name='[neighbourhood]' role='dimension' type='nominal' />
            <column-instance column='[neighbourhood]' derivation='None' name='[none:neighbourhood:nk]' pivot='key' type='nominal' />
            <column caption='Reviews Per Month' datatype='real' name='[reviews_per_month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0926676420743170]' derivation='User' name='[usr:Calculation_0926676420743170:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1ndonkf00memyc14fp4nv1bgu3e9].[Action (Neighbourhood)]'>
            <groupfilter function='level-members' level='[neighbourhood]' user:ui-action-filter='[Action1_16BEDC49E6B24A63A1D26C87AC8548DD]' user:ui-enumeration='all' user:ui-marker='enumerate' />
